{
  "name": "feed-the-floor",
  "private": true,
  "version": "0.0.33",
  "description": "Feed the Floor: Meet Your Fate — Dorf + Dungeon Keeper + Auto-Battler, deterministisch, async, PWA",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "prepare": "husky",
    "check": "pnpm run -s typecheck && node scripts/check-loc.mjs && node scripts/check-hygiene.mjs && node scripts/shinon/engine.mjs --full",
    "check:loc": "node scripts/check-loc.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check:shinon": "node scripts/shinon/engine.mjs --full",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "dev": "pnpm --filter @floor/client dev",
    "build": "pnpm --filter @floor/client build"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "husky": "9.1.7",
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "zod": "3.23.8"
  },
  "dependencies": {
    "pnpm": "^12.6.0"
  }
}
