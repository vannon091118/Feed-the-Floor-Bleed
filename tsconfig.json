{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // Der Typecheck hat genau einen Owner: `pnpm run -s typecheck` und die
    // Engine fahren dasselbe Programm. Vorher standen die beiden Flags nur auf
    // der Kommandozeile des Plugins, der Typecheck lief dadurch viermal. Hier
    // gelten sie für jeden Aufruf, auch in der IDE.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "paths": {
      "@floor/contracts": ["./packages/contracts/src"],
      "@floor/sim-core": ["./packages/sim-core/src"],
      "@floor/client/*": ["./packages/client/src/*"],
      "@floor/server/*": ["./packages/server/src/*"]
    }
  },
  "include": ["packages/*/src/**/*", "packages/*/test/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
