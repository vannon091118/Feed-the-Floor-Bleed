// Devcontainer für Feed the Floor.
//
// Node kommt aus dem TypeScript-Node-Image und erfüllt die `engines`-Vorgabe
// `>=22`. pnpm wird über Corepack in der in `package.json` gepinnten Version
// aktiviert (`packageManager`), danach installiert der Post-Create-Schritt die
// Workspace-Dependencies mit `--frozen-lockfile`, wie es die CI tut.
{
  "name": "Feed the Floor",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5-24-trixie",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    }
  },
  "postCreateCommand": "corepack enable && pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": ["erveepp.agnes-ai-for-copilot-chat"]
    }
  }
}
